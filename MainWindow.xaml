<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Task_Flyout.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Task_Flyout.Views"
    Title="Task Flyout">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown" SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <views:ProviderToBrushConverter x:Key="ColorHexToBrushConverter"/>
            <CollectionViewSource x:Name="GlobalSearchResultsSource" IsSourceGrouped="True"/>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="GlobalSearchAccelerator_Invoked"/>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="PageBackAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>
        <NavigationView x:Name="MainNav" AutomationProperties.AutomationId="MainNavigation" PaneDisplayMode="Auto"
                        CompactPaneLength="48" OpenPaneLength="168" IsPaneOpen="False" IsSettingsVisible="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        ItemInvoked="MainNav_ItemInvoked" BackRequested="MainNav_BackRequested">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow_NavToday" AutomationProperties.AutomationId="NavToday" Content="Today" Tag="Today">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconHome}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_NavCalendar" AutomationProperties.AutomationId="NavCalendar" Content="主日历视图" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconCalendar}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="MainWindow_NavTasks" x:Name="TasksNavItem" AutomationProperties.AutomationId="NavTasks" Content="任务" Tag="Tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconTasks}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="MainWindow_NavWeather" x:Name="WeatherNavItem" Content="天气" Tag="Weather">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" x:Name="WeatherNavIcon" Glyph="{StaticResource AppIconSunny}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="MainWindow_NavMail" x:Name="MailNavItem" AutomationProperties.AutomationId="NavMail" Content="邮件" Tag="Mail">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconMail}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="MainWindow_NavRss" x:Name="RssNavItem" Content="RSS" Tag="Rss">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconRss}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="NotificationActionStatus" IsOpen="False" IsClosable="True" Margin="12,8"
                         AutomationProperties.LiveSetting="Polite">
                    <InfoBar.ActionButton>
                        <Button MinHeight="{StaticResource TaskFlyoutButtonHeight}" x:Name="NotificationActionRetry" x:Uid="Notification_Retry" Content="Retry"
                                Click="NotificationActionRetry_Click" Visibility="Collapsed"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </NavigationView>

        <Grid x:Name="GlobalSearchOverlay"
              x:Uid="GlobalSearch_Overlay"
              AutomationProperties.AutomationId="GlobalSearchOverlay"
              AutomationProperties.Name="Global search and command palette"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="False"
              Canvas.ZIndex="100">
            <Border x:Name="GlobalSearchPanel"
                    AutomationProperties.AutomationId="GlobalSearchPanel"
                    Width="720"
                    MaxWidth="720"
                    MaxHeight="640"
                    Margin="20,72,20,20"
                    Padding="{StaticResource TaskFlyoutSectionPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource TaskFlyoutPopupCornerRadius}">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Grid RowSpacing="{StaticResource TaskFlyoutSpaceMedium}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="{StaticResource TaskFlyoutSpaceSmall}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="GlobalSearchBox"
                                        x:Uid="GlobalSearch_SearchBox"
                                        AutomationProperties.AutomationId="GlobalSearchBox"
                                        PlaceholderText="Search local data or run a command"
                                        TextChanged="GlobalSearchBox_TextChanged"
                                        KeyDown="GlobalSearchBox_KeyDown">
                            <AutoSuggestBox.QueryIcon>
                                <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconSearch}"/>
                            </AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>
                        <Button x:Name="GlobalSearchCloseButton"
                                x:Uid="GlobalSearch_Close"
                                AutomationProperties.AutomationId="GlobalSearchCloseButton"
                                Grid.Column="2"
                                Width="{StaticResource TaskFlyoutButtonIconSize}"
                                Height="{StaticResource TaskFlyoutButtonIconSize}"
                                Padding="0"
                                Click="GlobalSearchCloseButton_Click"
                                ToolTipService.ToolTip="Close">
                            <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconDismiss}" FontSize="{StaticResource TaskFlyoutIconNavigation}"/>
                        </Button>
                        <ProgressRing x:Name="GlobalSearchIndexProgress" Grid.Column="1"
                                      Width="16" Height="16" IsActive="False"/>
                    </Grid>
                    <ListView x:Name="GlobalSearchResultsList"
                              AutomationProperties.AutomationId="GlobalSearchResults"
                              Grid.Row="1"
                              ItemsSource="{Binding Source={StaticResource GlobalSearchResultsSource}}"
                              IsItemClickEnabled="True"
                              ItemClick="GlobalSearchResultsList_ItemClick"
                              SelectionMode="Single"
                              KeyDown="GlobalSearchResultsList_KeyDown">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="12,12,12,4" FontSize="{StaticResource TaskFlyoutFontCaption}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.AutomationId="{Binding AutomationId}" Padding="8,6" ColumnSpacing="{StaticResource TaskFlyoutSpaceMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{Binding Glyph}" FontSize="{StaticResource TaskFlyoutIconBody}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource TaskFlyoutSpaceTiny}">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="GlobalSearchHint"
                               x:Uid="GlobalSearch_Hint"
                               AutomationProperties.AutomationId="GlobalSearchHint"
                               Grid.Row="2"
                                Text="Local cached data only · Enter to open · Esc to close"
                                FontSize="{StaticResource TaskFlyoutFontCaption}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
