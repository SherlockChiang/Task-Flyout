<?xml version="1.0" encoding="utf-8"?>
<desktop:DesktopFlyout
    x:Class="Task_Flyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:DesktopFlyouts"
    xmlns:local="using:Task_Flyout"
    xmlns:models="using:Task_Flyout.Models"
    xmlns:views="using:Task_Flyout.Views"
    FlyoutWidth="360"
    FlyoutHeight="Auto"
    Margin="12"
    Placement="BottomRight"
    PopupDirection="Vertical"
    ActivationMode="Activate"
    HideOnLostFocus="True"
    IsTransitionAnimationEnabled="True"
    IsSwipeToDismissEnabled="False"
    IsBackdropEnabled="True"
    BackdropKind="Mica">

    <desktop:DesktopFlyoutIsland x:Name="FlyoutIsland" IslandHeight="*" BorderThickness="0">
    <Grid x:Name="RootGrid" Background="{ThemeResource LayerFillColorDefaultBrush}" UseLayoutRounding="True">
        <Grid.Resources>
            <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <local:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter"/>
            <local:ColorHexToBrushConverter x:Key="ColorHexToBrushConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ContentRow" Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="HeaderScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Uid="Flyout_BtnGoToToday" Grid.Column="0" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" Padding="0" Click="BtnGoToToday_Click">
                    <StackPanel>
                        <TextBlock x:Name="TxtRealTimeClock" Text="10:30" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtRealTimeDate" Text="2023-10-24" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button x:Uid="Flyout_BtnWeather" x:Name="WeatherPanel" Grid.Column="1" Background="Transparent" BorderThickness="0"
                        Padding="4" VerticalAlignment="Center" Visibility="Collapsed"
                        Click="BtnWeather_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock x:Name="WeatherIcon" Text="☀️" FontSize="22"
                                       FontFamily="Segoe UI Emoji" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Image x:Name="WeatherIconImage" Visibility="Collapsed" Stretch="Uniform"/>
                            <Image x:Name="WeatherIconImage1" Visibility="Collapsed" Stretch="Uniform"/>
                            <Image x:Name="WeatherIconImage2" Visibility="Collapsed" Stretch="Uniform"/>
                            <Image x:Name="WeatherIconImage3" Visibility="Collapsed" Stretch="Uniform"/>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtWeatherTemp" Text="--" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TxtWeatherDesc" Text="" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="60" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Weather detail strip (configurable fields) -->
            <ItemsControl x:Name="WeatherDetailStrip" Grid.Row="1" Margin="16,0,16,8" Visibility="Collapsed"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Expander x:Name="DateExpander" x:Uid="Flyout_DatePicker" Grid.Row="2"
                      Header="Choose date" IsExpanded="False" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Margin="16,0,16,12"
                      AutomationProperties.AutomationId="FlyoutDatePicker"
                      Expanding="DateExpander_Changed" Collapsed="DateExpander_Changed">
            <Grid x:Name="CalendarHost" HorizontalAlignment="Stretch" Height="354">
                <CalendarView x:Name="MainCalendar" 
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              CalendarItemCornerRadius="0"
                              CalendarItemBackground="Transparent"
                              CalendarItemHoverBackground="Transparent"
                              CalendarItemPressedBackground="Transparent"
                              CalendarItemDisabledBackground="Transparent"
                              TodayBackground="Transparent"
                              TodayHoverBackground="Transparent"
                              TodayPressedBackground="Transparent"
                              TodayDisabledBackground="Transparent"
                              TodayBlackoutBackground="Transparent"
                              TodayForeground="{ThemeResource TextFillColorPrimaryBrush}"
                              TodayBlackoutForeground="{ThemeResource TextFillColorPrimaryBrush}"
                              TodaySelectedInnerBorderBrush="Transparent"
                              SelectedForeground="{ThemeResource TextFillColorPrimaryBrush}"
                              SelectedHoverForeground="{ThemeResource TextFillColorPrimaryBrush}"
                              SelectedPressedForeground="{ThemeResource TextFillColorPrimaryBrush}"
                              SelectedDisabledForeground="{ThemeResource TextFillColorSecondaryBrush}"
                              SelectedBorderBrush="Transparent"
                              SelectedHoverBorderBrush="Transparent"
                              SelectedPressedBorderBrush="Transparent"
                              SelectedDisabledBorderBrush="Transparent"
                              CalendarViewDayItemChanging="MainCalendar_CalendarViewDayItemChanging" 
                              SelectedDatesChanged="MainCalendar_SelectedDatesChanged">
                    <CalendarView.CalendarViewDayItemStyle>
                        <Style TargetType="CalendarViewDayItem">
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="0"/>
                        </Style>
                    </CalendarView.CalendarViewDayItemStyle>
                </CalendarView>

            </Grid>
            </Expander>

        </Grid>
        </ScrollViewer>

        <Grid x:Name="AgendaContainer" Grid.Row="1" Margin="16,0,16,0" MinHeight="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,0,8" ColumnSpacing="8" RowSpacing="4" Background="Transparent" CornerRadius="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSelectedDateHeader" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtRelativeDate" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TaskMutationStatusText" Grid.Row="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Uid="TaskMutation_Retry" x:Name="RetryTaskMutationButton" Grid.Row="1" Grid.Column="1" Content="Retry" Visibility="Collapsed"
                        Click="RetryTaskMutationButton_Click" Padding="8,2"/>
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="AgendaStatePanel" Grid.Row="0" Margin="16,12" Spacing="6"
                                Visibility="Collapsed" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="AgendaStateTitle" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="AgendaStateSubtitle" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Uid="Flyout_AgendaRetry" x:Name="AgendaSyncRetryButton" Content="Retry sync"
                                    Visibility="Collapsed" Click="AgendaSyncRetryButton_Click"/>
                            <Button x:Uid="Flyout_AgendaAddAccount" x:Name="AgendaAddAccountButton" Content="Add account"
                                    Visibility="Collapsed" Click="AgendaAddAccountButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <ListView x:Name="AgendaListControl" Grid.Row="1" ItemsSource="{x:Bind AgendaItems, Mode=OneWay}"
                              SelectionMode="None" Padding="0,8" IsItemClickEnabled="True"
                              ItemClick="AgendaListControl_ItemClick"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AgendaItem">
                                <Grid Margin="12,6" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="24" Margin="0,0,12,0">
                                        <Border Width="4" HorizontalAlignment="Left"
                                                Background="{Binding ColorHex, Converter={StaticResource ColorHexToBrushConverter}}"
                                                CornerRadius="2" Visibility="{x:Bind IsEvent, Mode=OneWay}"/>
                                        <CheckBox IsChecked="{x:Bind IsCompleted, Mode=TwoWay}" MinWidth="0" Padding="0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Visibility="{x:Bind IsTask, Mode=OneWay}" Click="TaskCheckBox_Click"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                                                   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasLocation, Mode=OneWay}" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE707;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind Location, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource LayerFillColorAltBrush}"
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="FooterGrid" Grid.Row="2" Margin="16,12,16,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Uid="Flyout_OpenCalendar" Content="Full calendar" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="FlyoutOpenCalendar" Click="OpenCalendar_Click"/>
                <Button x:Uid="Flyout_OpenTasks" Grid.Column="1" Content="All tasks" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="FlyoutOpenTasks" Click="OpenTasks_Click"/>
            </Grid>
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Uid="Flyout_BtnSettings" Grid.Column="0" Click="BtnSettings_Click" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <SymbolIcon Symbol="Setting"/>
            </Button>
            <Button x:Uid="Flyout_BtnRefresh" Grid.Column="1" Click="BtnRefresh_Click" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <SymbolIcon Symbol="Refresh"/>
            </Button>
            <Button x:Uid="Flyout_BtnPin" x:Name="BtnPin" Grid.Column="2" Click="BtnPin_Click" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon x:Name="PinIcon" Glyph="&#xE77A;" FontSize="16"/>
            </Button>
            <ProgressRing x:Name="SyncProgress" Grid.Column="3" Width="20" Height="20" Margin="12,0,0,0"
                          IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Uid="Flyout_QuickCreate" Grid.Column="4" Content="Add"
                    HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="FlyoutQuickCreate" Click="BtnToggleAddPanel_Click"/>
            </Grid>
        </Grid>

        <Border x:Name="AddPanel" Grid.Row="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Margin="16,0,16,0" Padding="16" Visibility="Collapsed"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">

            <ScrollViewer x:Name="AddPanelScrollViewer" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <views:QuickCreateForm x:Name="QuickCreateEditor" Margin="0,0,0,12"/>
            </ScrollViewer>
        </Border>
    </Grid>
    </desktop:DesktopFlyoutIsland>
</desktop:DesktopFlyout>
