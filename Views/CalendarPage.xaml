<Page
    x:Class="Task_Flyout.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Task_Flyout.Models"
    xmlns:views="using:Task_Flyout.Views"
    Background="{ThemeResource TaskFlyoutPageBackgroundBrush}">

    <Page.Resources>
        <views:BoolToTodayBrushConverter x:Key="BoolToTodayBrushConverter"/>
        <views:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <views:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter"/>
        <views:ProviderToBrushConverter x:Key="ProviderToBrushConverter"/>
        <views:TaskCompletedOpacityConverter x:Key="TaskCompletedOpacityConverter"/>
        <views:ProviderToTextBrushConverter x:Key="ProviderToTextBrushConverter"/>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" AutomationProperties.AutomationId="CalendarLayoutRoot" Background="{ThemeResource TaskFlyoutPageBackgroundBrush}" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <!-- Proportional layout: side panes scale with the window and cap on wide
                 screens; the calendar keeps a readable floor (MinWidth) on small laptops. -->
            <ColumnDefinition x:Name="AccountColumn" Width="2*" MinWidth="240" MaxWidth="320"/>
            <ColumnDefinition x:Name="CalendarColumn" Width="5*" MinWidth="380"/>
            <ColumnDefinition x:Name="TimelineColumn" Width="3*" MinWidth="280" MaxWidth="420"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="AccountPane" AutomationProperties.AutomationId="CalendarAccountPane" Grid.Column="0"
              Background="{ThemeResource TaskFlyoutSectionBackgroundBrush}"
              BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}"
              BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}"
              CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
              Margin="24,28,12,28"
              Padding="12"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="4,0,0,8">
                <TextBlock x:Uid="CalendarPage_AccountHeader" Text="日程账户" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Uid="CalendarPage_BtnCollapseAccounts" AutomationProperties.AutomationId="CalendarCollapseAccounts" HorizontalAlignment="Right" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="ToggleAccountPane_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="AccountListRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Background="Transparent" BorderThickness="0" Padding="0" IsExpanded="True">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
                                </Expander.Resources>

                                <Expander.Header>
                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="15" Margin="0,0,12,0"
                                                  Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                                   Text="{Binding ProviderName}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" x:Uid="CalendarPage_BtnRemoveAccount" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                                                Tag="{Binding ProviderName}" Click="BtnRemoveAccount_Click" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        </Button>
                                    </Grid>
                                </Expander.Header>

                                <Expander.Content>
                                    <StackPanel Spacing="0" Margin="0,4,0,0">
                                        <ItemsRepeater ItemsSource="{Binding Calendars}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="0"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="32,0,0,8" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding ColorHex, Converter={StaticResource ProviderToBrushConverter}}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" FontSize="13"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <ToggleSwitch Grid.Column="2" IsOn="{Binding IsVisible, Mode=TwoWay}"
                                                                       OffContent="" OnContent="" MinWidth="0" Margin="0"
                                                                       Toggled="CalendarToggle_Toggled" VerticalAlignment="Center"
                                                                       AutomationProperties.Name="{Binding Name}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                        <Grid Margin="32,0,0,8" ColumnSpacing="8" Visibility="{Binding TaskSettingsVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TaskColorHex, Converter={StaticResource ProviderToBrushConverter}}"/>
                                            <TextBlock x:Uid="CalendarPage_TodoHeader" Grid.Column="1" Text="待办任务" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ToggleSwitch x:Uid="CalendarPage_TaskVisibilityToggle" Grid.Column="2" IsOn="{Binding ShowTasks, Mode=TwoWay}"
                                                           OffContent="" OnContent="" MinWidth="0" Margin="0"
                                                           Toggled="AccountToggle_Toggled" Tag="{Binding ProviderName}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Button Grid.Row="2" x:Name="BtnAddAccount" HorizontalAlignment="Stretch" Click="BtnAddAccount_Click" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock x:Uid="CalendarPage_AddAccount" Text="添加账户"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="3" x:Uid="MainWindow_BtnForceSync" Content="强制立即同步" HorizontalAlignment="Stretch" Click="BtnForceSync_Click"/>
        </Grid>

        <Grid x:Name="CalendarContent" AutomationProperties.AutomationId="CalendarContentPane" Grid.Column="1" Padding="28,32,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="CalendarToolbar" Grid.Row="0" ColumnSpacing="12" RowSpacing="8" Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Uid="CalendarPage_BtnToggleAccounts" x:Name="ToggleAccountPaneButton" AutomationProperties.AutomationId="CalendarToggleAccounts" Width="40" Height="36" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="ToggleAccountPane_Click">
                    <FontIcon x:Name="ToggleAccountPaneIcon" Glyph="&#xE76B;" FontSize="12"/>
                </Button>
                <Button x:Name="BtnMonthYear" Content="" FontSize="28" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                        Padding="8,4" Margin="-8,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Click="BtnMonthYear_Click"/>

                <ComboBox x:Name="CalendarViewModeBox" SelectionChanged="CalendarViewModeBox_SelectionChanged" Width="112" VerticalAlignment="Center">
                    <ComboBoxItem x:Uid="CalendarPage_ViewWeek" Content="周" Tag="Week"/>
                    <ComboBoxItem x:Uid="CalendarPage_ViewMonth" Content="月" Tag="Month" IsSelected="True"/>
                    <ComboBoxItem x:Uid="CalendarPage_ViewYear" Content="年" Tag="Year"/>
                </ComboBox>

                <Border Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}" BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}" CornerRadius="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="BtnPrevMonth_Click" Background="Transparent" BorderThickness="0" Width="40" Height="36" CornerRadius="6,0,0,6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                        </Button>
                        <MenuFlyoutSeparator Margin="0,8" Background="{ThemeResource TaskFlyoutDividerBrush}"/>
                        <Button Click="BtnNextMonth_Click" Background="Transparent" BorderThickness="0" Width="40" Height="36" CornerRadius="0,6,6,0">
                            <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Uid="CalendarPage_BtnToday" Content="今天" Click="BtnToday_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" CornerRadius="6"/>
                <Button x:Uid="CalendarPage_BtnToggleTimeline" x:Name="ToggleTimelinePaneButton" Width="40" Height="36" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="ToggleTimelinePane_Click">
                    <FontIcon x:Name="ToggleTimelinePaneIcon" Glyph="&#xE76C;" FontSize="12"/>
                </Button>
                </StackPanel>
                </ScrollViewer>
                <Grid x:Name="CalendarStatusPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      ColumnSpacing="8" MinWidth="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="SyncProgress" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CalendarStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                               TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding Text, ElementName=CalendarStatusText}"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                <Button x:Uid="TaskMutation_Retry" x:Name="RetryTaskMutationButton" Grid.Row="1" Grid.Column="2" Content="Retry" Visibility="Collapsed"
                        VerticalAlignment="Center" Click="RetryTaskMutationButton_Click" Padding="10,4"/>
            </Grid>

            <Grid x:Name="WeekHeaderGrid" Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Weekday headers are filled at runtime from the app-language culture
                     (see SetWeekdayHeaders) so they localize beyond the bundled resw files. -->
                <TextBlock x:Name="WeekHeader0" Grid.Column="0" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="WeekHeader1" Grid.Column="1" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="WeekHeader2" Grid.Column="2" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="WeekHeader3" Grid.Column="3" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="WeekHeader4" Grid.Column="4" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="WeekHeader5" Grid.Column="5" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="WeekHeader6" Grid.Column="6" HorizontalAlignment="Center" Opacity="0.8" FontWeight="SemiBold" FontSize="13"/>
            </Grid>

            <GridView x:Name="CalendarGrid" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{x:Bind DayCells}" SizeChanged="CalendarGrid_SizeChanged" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="CalendarGrid_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="WrapGrid" Orientation="Horizontal" MaximumRowsOrColumns="7"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:DayCellViewModel">
                        <Border Margin="3" Padding="8" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="{x:Bind IsToday, Mode=OneTime, Converter={StaticResource BoolToTodayBrushConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind DayNumber, Mode=OneTime}" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold" FontSize="15" Margin="2,0,0,0" Opacity="{x:Bind IsCurrentMonth, Mode=OneTime, Converter={StaticResource BoolToOpacityConverter}}"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Items, Mode=OneTime}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AgendaItem">
                                            <Border Background="{x:Bind ColorHex, Mode=OneTime, Converter={StaticResource ProviderToBrushConverter}}" Margin="0,2" Padding="6,4" CornerRadius="4">
                                                <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                                           Foreground="{x:Bind ColorHex, Mode=OneTime, Converter={StaticResource ProviderToTextBrushConverter}}"
                                                           FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="1" Text="{x:Bind OverflowText, Mode=OneWay}" Visibility="{x:Bind OverflowVisibility, Mode=OneWay}"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,0"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="WeekTimelineView" Grid.Row="2" Visibility="Collapsed" SizeChanged="WeekTimelineView_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{ThemeResource TaskFlyoutDividerBrush}" BorderThickness="0,0,1,1"/>
                <Canvas x:Name="WeekTimelineHeaderCanvas" Grid.Row="0" Grid.Column="1" Height="48"/>
                <Canvas x:Name="WeekTimeAxisCanvas" Grid.Row="1" Grid.Column="0" Width="56"/>
                <Canvas x:Name="WeekTimelineCanvas" Grid.Row="1" Grid.Column="1"/>
            </Grid>

            <GridView x:Name="YearGrid" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ItemsSource="{x:Bind YearMonths}" Visibility="Collapsed"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="YearGrid_ItemClick"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="YearWrapGrid" Orientation="Horizontal" MaximumRowsOrColumns="4"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:YearMonthViewModel">
                        <Border Width="226" MinHeight="214" Margin="6" Padding="12" CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
                                Background="{ThemeResource TaskFlyoutSectionBackgroundBrush}"
                                BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}"
                                BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind CountText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Days}" Margin="0,4,0,0">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MaximumRowsOrColumns="7" MinItemWidth="27" MinItemHeight="22"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:YearDayViewModel">
                                            <Grid Width="27" Height="22" Visibility="{x:Bind DayVisibility}" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                                <TextBlock Text="{x:Bind DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Border Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                        Background="{x:Bind ColorHex, Mode=OneTime, Converter={StaticResource ProviderToBrushConverter}}"
                                                        Visibility="{x:Bind MarkerVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="NoAccountEmptyState" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="320">
                <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Uid="CalendarPage_NoAccountTitle" Text="还没有连接日程账户" FontSize="18" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Uid="CalendarPage_NoAccountSub" Text="连接 Google 或 Microsoft 后，这里会显示日程和待办。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
                <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="BtnAddAccount_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock x:Uid="CalendarPage_AddAccount" Text="添加账户"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="TimelinePane" AutomationProperties.AutomationId="CalendarTimelinePane" Grid.Column="2"
              Background="{ThemeResource TaskFlyoutSectionBackgroundBrush}"
              BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}"
              BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}"
              CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
              Margin="12,28,24,28"
              Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,0,20" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="CalendarPage_AllAgendas" x:Name="TxtSideBarDate" Text="全部日程" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Uid="CalendarPage_BtnToggleAccounts" x:Name="TimelineAccountsButton" Grid.Column="1"
                        Visibility="Collapsed" VerticalAlignment="Center" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" Click="ToggleAccountPane_Click">
                    <FontIcon Glyph="&#xE716;" FontSize="13"/>
                </Button>
                <Button x:Uid="CalendarPage_BtnCollapseTimeline" x:Name="CollapseTimelinePaneButton" Grid.Column="2" VerticalAlignment="Center" Width="32" Height="32" Padding="0"
                         Background="Transparent" BorderThickness="0" Click="ToggleTimelinePane_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                </Button>
                <Button x:Uid="CalendarPage_BtnAdd" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Padding="12,4" Click="BtnAddNew_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock x:Uid="CalendarPage_BtnAddText" Text="新建" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
            <ListView x:Name="SideBarAgendaList" Grid.Row="1" ItemsSource="{x:Bind SelectedDayItems}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="SideBarAgendaList_ItemClick"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AgendaItem">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Subtitle}" FontSize="13" FontWeight="Medium" Opacity="0.6" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Border Grid.Column="1" Background="{ThemeResource TaskFlyoutCardBackgroundBrush}" BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}" BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}" CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}" Padding="12,14"
                                    AutomationProperties.Name="{x:Bind Title}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{x:Bind ColorHex, Converter={StaticResource ProviderToBrushConverter}}" Margin="0,0,12,0" VerticalAlignment="Stretch"/>

                                    <FontIcon Grid.Column="1" Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" Visibility="{x:Bind IsEvent}" VerticalAlignment="Top" Margin="0,3,12,0"/>

                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind IsEvent}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"/>
                                        <Grid Visibility="{x:Bind IsTask}" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsCompleted, Mode=TwoWay}" Click="TaskCheckBox_Click" Tapped="TaskCheckBox_Tapped" Margin="0,-6,8,0" MinWidth="0"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"
                                               TextDecorations="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToStrikethroughConverter}}"
                                               Opacity="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource TaskCompletedOpacityConverter}}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasLocation, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE707;" FontSize="12" Opacity="0.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Location, Mode=OneWay}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasDescription, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Opacity="0.5" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="13" Opacity="0.7" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ContentDialog x:Uid="CalendarDialog" x:Name="EditDialog" Title="编辑日程 / 任务" PrimaryButtonText="保存" SecondaryButtonText="删除" CloseButtonText="取消" PrimaryButtonClick="EditDialog_PrimaryButtonClick" SecondaryButtonClick="EditDialog_SecondaryButtonClick">
            <ScrollViewer x:Name="EditDialogScrollViewer" MaxHeight="560" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="16" MaxWidth="420" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                    <ComboBox x:Uid="CalendarDialog_Provider" x:Name="EditCmbProvider" Header="所属账户" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton x:Uid="CalendarDialog_RadioEvent" x:Name="EditRadioEvent" Content="日程" IsChecked="True" Checked="EditRadioType_Changed"/>
                        <RadioButton x:Uid="CalendarDialog_RadioTask" x:Name="EditRadioTask" Content="任务" Checked="EditRadioType_Changed"/>
                    </StackPanel>
                    <ComboBox x:Uid="CalendarDialog_RecurrenceCombo" x:Name="EditRecurrenceComboBox" Header="重复" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Uid="CalendarDialog_RecurrenceNone" Content="不重复" Tag="None"/>
                        <ComboBoxItem x:Uid="CalendarDialog_RecurrenceDaily" Content="每天" Tag="Daily"/>
                        <ComboBoxItem x:Uid="CalendarDialog_RecurrenceWeekly" Content="每周" Tag="Weekly"/>
                        <ComboBoxItem x:Uid="CalendarDialog_RecurrenceMonthly" Content="每月" Tag="Monthly"/>
                        <ComboBoxItem x:Uid="CalendarDialog_RecurrenceYearly" Content="每年" Tag="Yearly"/>
                    </ComboBox>

                    <TextBox x:Uid="CalendarDialog_TitleInput" x:Name="EditTxtTitle" Header="名称" PlaceholderText="日程名称"/>
                    <TextBlock x:Name="EditValidationText" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <TextBox x:Uid="CalendarDialog_LocationInput" x:Name="EditTxtLocation" Header="地点 (选填)" PlaceholderText="添加位置信息"/>
                    <TextBox x:Uid="CalendarDialog_DescInput" x:Name="EditTxtDescription" Header="详情备注 (选填)" PlaceholderText="记录详细内容..." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"/>
                    <StackPanel Spacing="8">
                        <DatePicker x:Uid="CalendarDialog_DateInput" x:Name="EditDatePicker" Header="日期" HorizontalAlignment="Stretch" MonthFormat="{}{month.integer(2)}" DayFormat="{}{day.integer(2)}"/>
                        <CheckBox x:Uid="CalendarDialog_AllDayInput" x:Name="EditChkAllDay" Content="全天事件" HorizontalAlignment="Left" Checked="EditChkAllDay_Changed" Unchecked="EditChkAllDay_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="EditTimePanel" Spacing="12">
                        <TimePicker x:Uid="CalendarDialog_StartTimeInput" x:Name="EditStartTimePicker" Header="开始时间" HorizontalAlignment="Stretch"/>
                        <TimePicker x:Uid="CalendarDialog_EndTimeInput" x:Name="EditEndTimePicker" Header="结束时间" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
