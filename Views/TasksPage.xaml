<Page
    x:Class="Task_Flyout.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Task_Flyout.Models"
    xmlns:views="using:Task_Flyout.Views"
    Background="{ThemeResource TaskFlyoutPageBackgroundBrush}">

    <Page.Resources>
        <views:ProviderToBrushConverter x:Key="ProviderToBrushConverter"/>
        <views:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter"/>
        <views:TaskCompletedOpacityConverter x:Key="TaskCompletedOpacityConverter"/>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" AutomationProperties.AutomationId="TasksLayoutRoot" Background="{ThemeResource TaskFlyoutPageBackgroundBrush}" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AccountColumn" Width="2*" MinWidth="240" MaxWidth="320"/>
            <ColumnDefinition x:Name="TaskContentColumn" Width="5*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <views:CompactNavigationBar x:Name="StepNavigation" Grid.ColumnSpan="2" Visibility="Collapsed"/>
        <views:AgendaDetailsPane x:Name="TaskDetails" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
        <Grid x:Name="AccountPane" AutomationProperties.AutomationId="TasksAccountPane" Grid.Column="0" Grid.Row="1"
              Background="{ThemeResource TaskFlyoutSectionBackgroundBrush}"
              BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}"
              BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}"
              CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
              Margin="24,28,12,28"
              Padding="12"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="4,0,0,8">
                <TextBlock x:Uid="TasksPage_AccountHeader" Text="任务账户" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="CollapseAccountsButton" x:Uid="TasksPage_BtnCollapseAccounts" HorizontalAlignment="Right" Width="{StaticResource TaskFlyoutButtonIconSize}" Height="{StaticResource TaskFlyoutButtonIconSize}" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="ToggleAccountPane_Click">
                    <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconChevronLeft}" FontSize="{StaticResource TaskFlyoutIconSmall}"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="AccountListRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource TaskFlyoutSpaceXSmall}"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      IsExpanded="True">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
                                </Expander.Resources>

                                <Expander.Header>
                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="{StaticResource TaskFlyoutIconBody}"
                                                  Margin="{StaticResource TaskFlyoutTrailingIconMargin}"
                                                  Foreground="{ThemeResource SystemAccentColor}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="{StaticResource TaskFlyoutFontBody}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DisplayTitle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Uid="TasksPage_BtnRemoveAccount" Grid.Column="2" Width="{StaticResource TaskFlyoutButtonIconSize}" Height="{StaticResource TaskFlyoutButtonIconSize}" Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{Binding AccountId}"
                                                Click="BtnRemoveAccount_Click"
                                                VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconDismiss}" FontSize="{StaticResource TaskFlyoutIconSmall}"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        </Button>
                                    </Grid>
                                </Expander.Header>

                                <Expander.Content>
                                    <Grid Margin="32,0,0,8" ColumnSpacing="{StaticResource TaskFlyoutSpaceSmall}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
                                                VerticalAlignment="Center"
                                                Background="{Binding TaskColorHex, Converter={StaticResource ProviderToBrushConverter}}"/>
                                        <TextBlock x:Uid="TasksPage_TodoHeader" Grid.Column="1" Text="待办任务"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{StaticResource TaskFlyoutFontSecondary}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ToggleSwitch x:Uid="TasksPage_TaskVisibilityToggle" Grid.Column="2"
                                                       IsOn="{Binding ShowTasks, Mode=TwoWay}"
                                                       OffContent=""
                                                       OnContent=""
                                                       MinWidth="0"
                                                       Margin="0"
                                                       Toggled="AccountToggle_Toggled"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Button MinHeight="{StaticResource TaskFlyoutButtonHeight}" Grid.Row="2" HorizontalAlignment="Stretch" Click="BtnAddAccount_Click" Margin="{StaticResource TaskFlyoutRowMargin}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceSmall}">
                    <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconAdd}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                    <TextBlock x:Uid="TasksPage_AddAccount" Text="添加账户"/>
                </StackPanel>
            </Button>

            <Button MinHeight="{StaticResource TaskFlyoutButtonHeight}" Grid.Row="3" x:Uid="MainWindow_BtnForceSync" Content="强制立即同步" HorizontalAlignment="Stretch" Click="BtnForceSync_Click"/>
        </Grid>

        <Grid x:Name="TaskContent" AutomationProperties.AutomationId="TasksContentPane" Grid.Column="1" Grid.Row="1" Padding="28,32,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,24" ColumnSpacing="{StaticResource TaskFlyoutSpaceSmall}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceMedium}" VerticalAlignment="Center">
                    <Button x:Uid="TasksPage_BtnExpandAccounts" x:Name="ToggleAccountPaneButton" AutomationProperties.AutomationId="TasksToggleAccounts"
                            Width="{StaticResource TaskFlyoutButtonIconSize}"
                            Height="{StaticResource TaskFlyoutButtonToolbarHeight}"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ToggleAccountPane_Click">
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" x:Name="ToggleAccountPaneIcon" Glyph="{StaticResource AppIconChevronRight}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                    </Button>
                    <StackPanel Spacing="{StaticResource TaskFlyoutSpaceTiny}" MinWidth="0">
                        <TextBlock x:Uid="TasksPage_Title" Text="任务" FontSize="28" FontWeight="SemiBold"/>
                         <TextBlock x:Uid="TasksPage_Loading" x:Name="TaskSummaryText"
                                   Text="正在加载任务"
                                   FontSize="{StaticResource TaskFlyoutFontSecondary}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button MinHeight="{StaticResource TaskFlyoutButtonHeight}" x:Uid="TaskMutation_Retry" x:Name="RetryTaskMutationButton" Content="Retry" Visibility="Collapsed"
                                HorizontalAlignment="Left" Click="RetryTaskMutationButton_Click"/>
                    </StackPanel>
                </StackPanel>
                <ProgressRing x:Name="SyncProgress"
                              Grid.Column="1"
                              Width="24"
                              Height="24"
                              VerticalAlignment="Center"
                              IsActive="False"
                              Visibility="Collapsed"/>
                <Button MinHeight="{StaticResource TaskFlyoutButtonHeight}" Grid.Column="2"
                        Click="AddTaskButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceSmall}">
                        <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconAdd}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                        <TextBlock x:Uid="TasksPage_AddTask" x:Name="AddTaskButtonText" Text="添加任务"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="{StaticResource TaskFlyoutSpaceSmall}" Margin="0,0,0,16">
            <views:TaskMailActionsPanel/>
            <AutoSuggestBox x:Uid="TasksPage_Search"
                            x:Name="TaskSearchBox"
                            PlaceholderText="Search cached tasks"
                            TextChanged="TaskSearchBox_TextChanged"
                            AutomationProperties.Name="Search cached tasks"/>
            </StackPanel>

            <Grid Grid.Row="2" RowSpacing="14" MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" RowSpacing="{StaticResource TaskFlyoutSpaceMedium}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="TasksPage_PendingHeader" x:Name="PendingHeaderText" Text="待完成" FontSize="18" FontWeight="SemiBold"/>
                    <ListView Grid.Row="1"
                              x:Name="PendingTasksList"
                              IsItemClickEnabled="True" ItemClick="TaskList_ItemClick"
                              ItemsSource="{x:Bind PendingTasks}"
                              MaxHeight="360"
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AgendaItem">
                                <Border Background="{ThemeResource TaskFlyoutCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}"
                                        BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}"
                                        CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid ColumnSpacing="{StaticResource TaskFlyoutSpaceMedium}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                         <CheckBox Grid.Column="0"
                                                   IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                                   Click="TaskCheckBox_Click" Tapped="TaskAction_Tapped"
                                                   AutomationProperties.Name="{x:Bind Title}"
                                                  VerticalAlignment="Top"
                                                  MinWidth="0"
                                                  Padding="0"
                                                  Margin="0,2,0,0"/>
                                        <Border Grid.Column="1"
                                                Background="{x:Bind ColorHex, Converter={StaticResource ProviderToBrushConverter}}"
                                                CornerRadius="2"
                                                VerticalAlignment="Stretch"/>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource TaskFlyoutFontSection}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceSmall}">
                                                <TextBlock Text="{x:Bind Provider}" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="·" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{x:Bind DateKey}" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="{StaticResource TaskFlyoutFontSecondary}" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasDescription}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceTiny}">
                                            <Button x:Uid="TasksPage_BtnEditTask" Width="{StaticResource TaskFlyoutButtonHeight}" Height="{StaticResource TaskFlyoutButtonHeight}" Padding="0" Background="Transparent" BorderThickness="0"
                                                    DataContext="{x:Bind}" Click="EditTaskButton_Click" Tapped="TaskAction_Tapped">
                                                <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconEdit}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                                            </Button>
                                            <Button x:Uid="TasksPage_BtnDeleteTask" Width="{StaticResource TaskFlyoutButtonHeight}" Height="{StaticResource TaskFlyoutButtonHeight}" Padding="0" Background="Transparent" BorderThickness="0"
                                                    Click="DeleteTaskButton_Click" Tapped="TaskAction_Tapped">
                                                <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconDelete}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Uid="TasksPage_NoPending" x:Name="PendingEmptyText"
                               Grid.Row="1"
                               Text="已经没有未完成任务"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,28"
                               FontSize="{StaticResource TaskFlyoutFontBody}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{ThemeResource TaskFlyoutDividerBrush}"/>

                <Grid Grid.Row="2" RowSpacing="{StaticResource TaskFlyoutSpaceMedium}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="TasksPage_CompletedHeader" x:Name="CompletedHeaderText" Text="已完成" FontSize="18" FontWeight="SemiBold"/>
                    <ListView Grid.Row="1"
                              x:Name="CompletedTasksList"
                              IsItemClickEnabled="True" ItemClick="TaskList_ItemClick"
                              ItemsSource="{x:Bind CompletedTasks}"
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AgendaItem">
                                <Border Background="{ThemeResource TaskFlyoutCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}"
                                        BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}"
                                        CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}"
                                        Padding="14"
                                        Margin="0,0,0,10"
                                        Opacity="0.78">
                                    <Grid ColumnSpacing="{StaticResource TaskFlyoutSpaceMedium}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                         <CheckBox Grid.Column="0"
                                                   IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                                   Click="TaskCheckBox_Click" Tapped="TaskAction_Tapped"
                                                   AutomationProperties.Name="{x:Bind Title}"
                                                  VerticalAlignment="Top"
                                                  MinWidth="0"
                                                  Padding="0"
                                                  Margin="0,2,0,0"/>
                                        <Border Grid.Column="1"
                                                Background="{x:Bind ColorHex, Converter={StaticResource ProviderToBrushConverter}}"
                                                CornerRadius="2"
                                                VerticalAlignment="Stretch"/>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="{StaticResource TaskFlyoutFontSection}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"
                                                       Opacity="{x:Bind IsCompleted, Converter={StaticResource TaskCompletedOpacityConverter}}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceSmall}">
                                                <TextBlock Text="{x:Bind Provider}" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="·" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{x:Bind DateKey}" FontSize="{StaticResource TaskFlyoutFontCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="{StaticResource TaskFlyoutFontSecondary}" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasDescription}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource TaskFlyoutSpaceTiny}">
                                            <Button x:Uid="TasksPage_BtnEditTask" Width="{StaticResource TaskFlyoutButtonHeight}" Height="{StaticResource TaskFlyoutButtonHeight}" Padding="0" Background="Transparent" BorderThickness="0"
                                                    DataContext="{x:Bind}" Click="EditTaskButton_Click" Tapped="TaskAction_Tapped">
                                                <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconEdit}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                                            </Button>
                                            <Button x:Uid="TasksPage_BtnDeleteTask" Width="{StaticResource TaskFlyoutButtonHeight}" Height="{StaticResource TaskFlyoutButtonHeight}" Padding="0" Background="Transparent" BorderThickness="0"
                                                    Click="DeleteTaskButton_Click" Tapped="TaskAction_Tapped">
                                                <FontIcon Style="{StaticResource TaskFlyoutIconStyle}" Glyph="{StaticResource AppIconDelete}" FontSize="{StaticResource TaskFlyoutIconBody}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
