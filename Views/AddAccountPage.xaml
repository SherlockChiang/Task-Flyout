<Page
    x:Class="Task_Flyout.Views.AddAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource TaskFlyoutPageBackgroundBrush}">

    <ScrollViewer x:Name="AddAccountScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto"
                  HorizontalContentAlignment="Stretch"
                  SizeChanged="AddAccountScrollViewer_SizeChanged">
    <Grid x:Name="AddAccountLayoutRoot" Padding="{StaticResource TaskFlyoutPagePadding}" HorizontalAlignment="Stretch">
        <StackPanel x:Name="AddAccountContent" Spacing="24">
            <TextBlock x:Uid="AddAccount_Title" Text="添加账户" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Uid="AddAccount_Subtitle" Text="选择要连接的账户类型" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="WrapWholeWords"/>

            <Border Padding="{StaticResource TaskFlyoutSectionPadding}" CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}" Background="{ThemeResource TaskFlyoutCardBackgroundBrush}" BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}" BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AddAccount_ChecklistTitle" Text="Setup checklist" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ChecklistText" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="ConnectedAccountsTitle" x:Uid="AddAccount_ConnectedAccountsTitle" Text="Connected accounts" FontSize="12" FontWeight="SemiBold"/>
                    <StackPanel x:Name="ConnectedAccountActions" Spacing="4"/>
                    <TextBlock x:Name="HealthText" Text="" TextWrapping="Wrap" FontSize="12"/>
                    <StackPanel Spacing="8">
                        <Button x:Name="RetrySyncButton" x:Uid="AddAccount_RetrySync" Content="Retry sync" Click="RetrySyncButton_Click" Padding="10,4"/>
                        <Button x:Name="OpenMailSetupButton" Click="OpenMailSetupButton_Click" Padding="10,4">
                            <TextBlock x:Uid="AddAccount_OpenMailSetup" Text="Open Mail setup" FontSize="12"/>
                        </Button>
                        <Button x:Name="OpenWeatherSetupButton" Click="OpenWeatherSetupButton_Click" Padding="10,4">
                            <TextBlock x:Uid="AddAccount_OpenWeatherSetup" Text="Open Weather setup" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Google -->
            <Button x:Name="BtnGoogle" HorizontalAlignment="Stretch" Padding="16" Click="BtnGoogle_Click"
                    HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE77B;" Foreground="#EA4335" FontSize="24"/>
                     <StackPanel Spacing="2" VerticalAlignment="Center" MinWidth="0">
                        <TextBlock x:Uid="AddAccount_GoogleTitle" Text="Google" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="AddAccount_GoogleDesc" Text="Google 日历与任务" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Microsoft -->
            <Button x:Name="BtnMicrosoft" HorizontalAlignment="Stretch" Padding="16" Click="BtnMicrosoft_Click"
                    HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE77B;" Foreground="#0078D4" FontSize="24"/>
                     <StackPanel Spacing="2" VerticalAlignment="Center" MinWidth="0">
                        <TextBlock x:Uid="AddAccount_MSTitle" Text="Microsoft" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="AddAccount_MSDesc" Text="Outlook 日历与 To Do" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- iCloud -->
            <Button x:Name="BtnICloud" HorizontalAlignment="Stretch" Padding="16" Click="BtnICloud_Click"
                    HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE787;" Foreground="#6E6E73" FontSize="24"/>
                    <StackPanel Spacing="2" VerticalAlignment="Center" MinWidth="0">
                        <TextBlock x:Uid="AddAccount_ICloudTitle" Text="iCloud" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="AddAccount_ICloudDesc" Text="iCloud Calendar" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <ProgressRing x:Name="AuthProgress" IsActive="False" Width="32" Height="32"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"/>
            <StackPanel x:Name="OnboardingActions" Spacing="8" HorizontalAlignment="Stretch">
                <Button x:Uid="AddAccount_Skip" Content="Skip for now" Click="SkipButton_Click"/>
                <Button x:Uid="AddAccount_Finish" Content="Finish setup" Style="{StaticResource AccentButtonStyle}" Click="FinishButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
