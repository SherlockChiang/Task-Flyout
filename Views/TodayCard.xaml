<UserControl
    x:Class="Task_Flyout.Views.TodayCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Task_Flyout.Views">
    <Border Background="{ThemeResource TaskFlyoutCardBackgroundBrush}"
            BorderBrush="{ThemeResource TaskFlyoutSectionBorderBrush}" BorderThickness="{StaticResource TaskFlyoutSectionBorderThickness}" CornerRadius="{StaticResource TaskFlyoutSectionCornerRadius}" Padding="{StaticResource TaskFlyoutSectionPadding}">
        <StackPanel Spacing="{StaticResource TaskFlyoutSpaceMedium}">
            <TextBlock x:Name="Heading" FontSize="{StaticResource TaskFlyoutFontSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <views:ContentState x:Name="LoadState"/>
            <TextBlock x:Name="Summary" FontSize="{StaticResource TaskFlyoutFontHeading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite"/>
            <ListView x:Name="Rows" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Rows_ItemClick"
                      HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:TodayCardRow">
                        <StackPanel Spacing="3" Padding="0,6">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Subtitle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Spacing="{StaticResource TaskFlyoutSpaceSmall}">
                <Button MinHeight="{StaticResource TaskFlyoutButtonHeight}" x:Name="OpenButton" HorizontalAlignment="Stretch" Click="OpenButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
